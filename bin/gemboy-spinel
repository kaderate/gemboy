# frozen_string_literal: true

require_relative '../lib/driver'

rom_path = ARGV[0]
frames = (ARGV[1] || 1).to_i

unless rom_path
  warn "Usage: #{$PROGRAM_NAME} ROM.gb [frames]"
  exit 1
end

raise ArgumentError, 'frames must be >= 1' if frames < 1

driver = Driver.build(rom_path, force_cgb: false)
driver.advance_frames(frames)
puts "Emulated #{frames} #{frames == 1 ? 'frame' : 'frames'}"
