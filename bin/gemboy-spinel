#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'driver'

rom_path = ARGV[0]
frames = (ARGV[1] || 1).to_i

unless rom_path
  warn "Usage: #{$PROGRAM_NAME} ROM.gb [frames]"
  exit 1
end

raise ArgumentError, 'frames must be >= 1' if frames < 1

driver = Driver.build(rom_path, force_cgb: false)
driver.advance_frames(frames)
puts "Emulated #{frames} frame#{frames == 1 ? '' : 's'}"
