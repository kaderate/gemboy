            <path d="M0,0 L10,5 L0,10 z" fill="var(--ink-faint)"></path>
          </marker>
        </defs>

        <line x1="640" y1="189" x2="640" y2="216" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow-ok)"></line>
        <text x="656" y="207" class="edge-label" fill="var(--ink-soft)">porte sud</text>

        <line x1="640" y1="389" x2="640" y2="416" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow-ok)"></line>
        <text x="656" y="407" class="edge-label" fill="var(--ink-soft)">sortie sud</text>

        <line x1="605" y1="589" x2="290" y2="616" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow-ok)"></line>
        <text x="430" y="595" class="edge-label" fill="var(--ink-soft)">scroll (scripté : 40 bas + 44 gauche)</text>

        <line x1="360" y1="704" x2="556" y2="704" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow-ok)"></line>
        <text x="366" y="695" class="edge-label" fill="var(--ink-soft)">porte (2ᵉ maison)</text>

        <line x1="280" y1="620" x2="280" y2="593" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow-ok)"></line>
        <text x="296" y="609" class="edge-label" fill="var(--ink-soft)">sortie nord</text>

        <line x1="720" y1="505" x2="796" y2="505" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow-ok)"></line>
        <text x="726" y="496" class="edge-label" fill="var(--ink-soft)">sortie est</text>

        <g>
          <rect x="560" y="20" width="160" height="169" rx="8" fill="var(--panel)" stroke="var(--ok-line)" stroke-width="1.6"></rect>
