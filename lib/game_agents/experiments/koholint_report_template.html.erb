          <text x="640" y="176" text-anchor="middle" class="node-title" fill="var(--ink)">starting_house</text>
        </g>

        <g>
          <rect x="560" y="220" width="160" height="169" rx="8" fill="var(--panel)" stroke="var(--ok-line)" stroke-width="1.6"></rect>
          <image href="data:image/png;base64,<%= images["front_yard"] %>" x="565" y="225" width="150" height="135" preserveAspectRatio="xMidYMid slice"></image>
          <rect x="565" y="225" width="150" height="135" rx="4" fill="none" stroke="var(--line)"></rect>
