          <text x="280" y="776" text-anchor="middle" class="node-title" fill="var(--ink)">overworld_screen3</text>
        </g>

        <g>
          <rect x="200" y="420" width="160" height="169" rx="8" fill="var(--panel)" stroke="var(--ok-line)" stroke-width="1.6"></rect>
          <image href="data:image/png;base64,<%= images["screen3_north"] %>" x="205" y="425" width="150" height="135" preserveAspectRatio="xMidYMid slice"></image>
          <rect x="205" y="425" width="150" height="135" rx="4" fill="none" stroke="var(--line)"></rect>
          <text x="280" y="576" text-anchor="middle" class="node-title" fill="var(--ink)">screen3_north</text>
        </g>

        <g>
          <rect x="800" y="420" width="160" height="169" rx="8" fill="var(--panel)" stroke="var(--ok-line)" stroke-width="1.6"></rect>
          <image href="data:image/png;base64,<%= images["shop_screen"] %>" x="805" y="425" width="150" height="135" preserveAspectRatio="xMidYMid slice"></image>
          <rect x="805" y="425" width="150" height="135" rx="4" fill="none" stroke="var(--line)"></rect>
          <text x="880" y="576" text-anchor="middle" class="node-title" fill="var(--ink)">shop_screen</text>
        </g>

        <g>
          <rect x="810" y="230" width="140" height="100" rx="8" fill="var(--unknown-soft)" stroke="var(--ink-faint)" stroke-width="1.6" stroke-dasharray="6 5"></rect>
          <text x="880" y="272" text-anchor="middle" class="node-title" fill="var(--ink-soft)">au nord du magasin</text>
          <text x="880" y="289" text-anchor="middle" class="node-sub" fill="var(--ink-faint)">sortie vue, non suivie</text>
        </g>

        <g>
          <rect x="20" y="455" width="140" height="100" rx="8" fill="var(--unknown-soft)" stroke="var(--ink-faint)" stroke-width="1.6" stroke-dasharray="6 5"></rect>
          <text x="90" y="497" text-anchor="middle" class="node-title" fill="var(--ink-soft)">à l'ouest</text>
          <text x="90" y="514" text-anchor="middle" class="node-sub" fill="var(--ink-faint)">sortie vue, non suivie</text>
        </g>

        <g>
          <rect x="400" y="455" width="140" height="100" rx="8" fill="var(--unknown-soft)" stroke="var(--ink-faint)" stroke-width="1.6" stroke-dasharray="6 5"></rect>
          <text x="470" y="497" text-anchor="middle" class="node-title" fill="var(--ink-soft)">à l'est</text>
          <text x="470" y="514" text-anchor="middle" class="node-sub" fill="var(--ink-faint)">sortie vue, non suivie</text>
        </g>
      </svg>
      <div class="legend">
        <div class="legend-item"><span class="swatch" style="background:var(--ok-soft);border-color:var(--ok-line)"></span>Écran cartographié</div>
        <div class="legend-item"><span class="swatch" style="background:var(--unknown-soft)"></span>Repéré, pas encore exploré</div>
        <div class="legend-item">— transition confirmée</div>
        <div class="legend-item" style="opacity:.75">┄┄ sortie détectée, non suivie</div>
      </div>
    </div>
  </section>

  <section>
    <h2>Le détail, case par case</h2>
    <p class="section-note">
      Chaque petite tuile est une cellule de jeu (16×16px) déjà testée. Les traits sur les bords
      indiquent ce qui a été confirmé dans chaque direction ; une case pâle a été repérée par un
      voisin mais pas encore visitée.
    </p>
    <div class="grids" id="grids"></div>
  </section>

  <section>
    <h2>Ce qu'on a appris en chemin</h2>
    <div class="findings">
      <%= findings_html %>
    </div>
  </section>

  <footer>
    <span>Zelda: Link's Awakening DX — gemboy, agent d'exploration autonome</span>
    <span><%= generated_at %></span>
  </footer>
</div>

<script>
  const SCREENS = <%= screens_json %>;
  const SCREEN_META = <%= screen_meta_json %>;

  const SVGNS = "http://www.w3.org/2000/svg";
  function el(tag, attrs) {
    const n = document.createElementNS(SVGNS, tag);
    for (const k in attrs) n.setAttribute(k, attrs[k]);
    return n;
  }
  const edgeColor = { ok: "var(--ok-line)", blocked: "var(--wall-line)", exit: "var(--exit-line)" };
  const cellFill = (e) => {
    if (!Object.keys(e).length) return "var(--unknown-soft)";
    if (Object.values(e).includes("blocked")) return "var(--wall-soft)";
    if (Object.values(e).includes("exit")) return "var(--exit-soft)";
    return "var(--ok-soft)";
  };

  function renderGrid(svg, cells) {
    const rows = cells.map(c => c.r), cols = cells.map(c => c.c);
    const r0 = Math.min(...rows), r1 = Math.max(...rows);
    const c0 = Math.min(...cols), c1 = Math.max(...cols);
    const cs = 40, pad = 6;
    const W = (c1 - c0 + 1) * cs + pad * 2;
    const H = (r1 - r0 + 1) * cs + pad * 2;
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);

    cells.forEach(({ r, c, e }) => {
      const x = pad + (c - c0) * cs, y = pad + (r - r0) * cs;
      svg.appendChild(el("rect", {
        x: x + 2, y: y + 2, width: cs - 4, height: cs - 4, rx: 3,
        fill: cellFill(e), stroke: "var(--line)", "stroke-width": 1,
      }));
      const t = 4;
      if (e.u) svg.appendChild(el("rect", { x: x + 6, y: y, width: cs - 12, height: t, fill: edgeColor[e.u] }));
      if (e.d) svg.appendChild(el("rect", { x: x + 6, y: y + cs - t, width: cs - 12, height: t, fill: edgeColor[e.d] }));
      if (e.l) svg.appendChild(el("rect", { x: x, y: y + 6, width: t, height: cs - 12, fill: edgeColor[e.l] }));
      if (e.r) svg.appendChild(el("rect", { x: x + cs - t, y: y + 6, width: t, height: cs - 12, fill: edgeColor[e.r] }));
    });
  }

  const gridsHost = document.getElementById("grids");
  for (const key in SCREENS) {
    const meta = SCREEN_META[key];
    const card = document.createElement("div");
    card.className = "grid-card";
    card.innerHTML = `
      <div class="grid-card-head"><span class="name">${meta.name}</span><span class="count">${SCREENS[key].length} cases vues</span></div>
      <div class="grid-card-sub">${meta.note}</div>
    `;
    const svg = el("svg", { role: "img", "aria-label": `Grille explorée de ${meta.name}` });
    card.appendChild(svg);
    gridsHost.appendChild(card);
    renderGrid(svg, SCREENS[key]);
  }
</script>
