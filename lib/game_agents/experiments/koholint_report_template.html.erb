<title>Carnet de Koholint</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap">
<style>
  :root {
    --paper: #eef1e2;
    --paper-line: #dfe4cf;
    --panel: #fbfcf6;
    --ink: #1f2417;
    --ink-soft: #565d47;
    --ink-faint: #8a9078;
    --line: #cdd4b8;
    --ok: #4c7a1c;
    --ok-soft: #dbe8c0;
    --ok-line: #9db878;
    --wall: #8a4a23;
    --wall-soft: #ecdcc9;
    --wall-line: #c99a6d;
    --exit: #2c5f86;
    --exit-soft: #d7e5ee;
    --exit-line: #8ab0c8;
    --unknown: #8f8a78;
    --unknown-soft: #e4e1d3;
    --shadow: 0 1px 0 rgba(31,36,23,0.05), 0 4px 14px rgba(31,36,23,0.06);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #12150d;
      --paper-line: #262b1a;
      --panel: #191d12;
      --ink: #e7ead9;
      --ink-soft: #a9af96;
      --ink-faint: #6f755f;
      --line: #2e341f;
      --ok: #93c945;
      --ok-soft: #22300f;
      --ok-line: #3f5620;
      --wall: #e0a066;
      --wall-soft: #33220f;
      --wall-line: #5c3d1c;
      --exit: #7fb4de;
      --exit-soft: #12222e;
      --exit-line: #274a63;
      --unknown: #756f5c;
      --unknown-soft: #211f16;
      --shadow: 0 1px 0 rgba(0,0,0,0.2), 0 4px 20px rgba(0,0,0,0.35);
    }
  }
  :root[data-theme="dark"] {
    --paper: #12150d;
    --paper-line: #262b1a;
    --panel: #191d12;
    --ink: #e7ead9;
    --ink-soft: #a9af96;
    --ink-faint: #6f755f;
    --line: #2e341f;
    --ok: #93c945;
    --ok-soft: #22300f;
    --ok-line: #3f5620;
    --wall: #e0a066;
    --wall-soft: #33220f;
    --wall-line: #5c3d1c;
    --exit: #7fb4de;
    --exit-soft: #12222e;
    --exit-line: #274a63;
    --unknown: #756f5c;
    --unknown-soft: #211f16;
    --shadow: 0 1px 0 rgba(0,0,0,0.2), 0 4px 20px rgba(0,0,0,0.35);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    background-image:
      linear-gradient(var(--paper-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--paper-line) 1px, transparent 1px);
    background-size: 28px 28px;
    color: var(--ink);
    font-family: "IBM Plex Mono", ui-monospace, "SF Mono", Consolas, monospace;
    line-height: 1.55;
  }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 40px 24px 64px; }

  .eyebrow {
    font-family: "Press Start 2P", monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--ok);
    margin: 0 0 14px;
  }
  h1 {
    font-family: "Press Start 2P", monospace;
    font-size: clamp(19px, 3.4vw, 30px);
    line-height: 1.5;
    text-wrap: balance;
    margin: 0 0 18px;
    color: var(--ink);
  }
  .lede {
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 14px;
    margin: 0 0 28px;
  }
  .lede b { color: var(--ink); font-weight: 600; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 40px;
  }
  .stat { background: var(--panel); padding: 16px 18px; }
  .stat .n { font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ok); }
  .stat .l { font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); margin-top: 2px; }

  section { margin-bottom: 48px; }
  h2 {
    font-family: "Press Start 2P", monospace;
    font-size: 13px;
    letter-spacing: 0.02em;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .section-note { font-size: 12.5px; color: var(--ink-soft); margin: 0 0 20px; max-width: 68ch; }

  .map-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 20px;
    overflow-x: auto;
  }
  .map-panel svg { display: block; margin: 0 auto; max-width: 100%; height: auto; }

  .node-title { font-family: "IBM Plex Mono", monospace; font-weight: 600; font-size: 12.5px; }
  .node-sub { font-size: 9.5px; letter-spacing: 0.04em; }
  .edge-label { font-size: 9.5px; }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }
  .legend-item { display: flex; align-items: center; gap: 7px; font-size: 11px; color: var(--ink-soft); }
  .swatch { width: 13px; height: 13px; border-radius: 3px; flex: none; border: 1px solid var(--line); }

  .grids { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
  .grid-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 18px 18px 16px;
  }
  .grid-card-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; gap: 10px; }
  .grid-card-head .name { font-weight: 700; font-size: 13px; }
  .grid-card-head .count { font-size: 10.5px; color: var(--ink-faint); white-space: nowrap; }
  .grid-card-sub { font-size: 10.5px; color: var(--ink-soft); margin-bottom: 12px; }
  .grid-card svg { display: block; margin: 0 auto; width: 100%; height: auto; }

  .findings { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
  .finding {
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--ok-line);
    border-radius: 6px;
    padding: 14px 16px;
    font-size: 12px;
    color: var(--ink-soft);
  }
  .finding.blocked { border-left-color: var(--wall-line); }
  .finding.open { border-left-color: var(--exit-line); }
  .finding .tag {
    display: block;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 5px;
  }
  .finding b { color: var(--ink); }
  .finding code { background: var(--unknown-soft); padding: 1px 5px; border-radius: 3px; font-size: 11px; }

  footer {
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 10.5px;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>

<div class="wrap">
  <p class="eyebrow">RELEVÉ DE TERRAIN — AGENT D'EXPLORATION</p>
  <h1>L'île de Koholint,<br>telle qu'explorée jusqu'ici</h1>
  <p class="lede">
    Carte reconstruite <b>uniquement à partir de ce que l'agent a réellement testé</b> en jeu —
    aucune case n'est devinée : chaque flèche, chaque mur et chaque case grise vient d'un test de
    déplacement réel ou d'un tir de catalogue déjà confirmé ailleurs. Régénérée automatiquement par
    <code>generate_koholint_report.rb</code> à partir des données courantes.
  </p>

  <div class="stats">
    <div class="stat"><div class="n"><%= screens.size %></div><div class="l">écrans repérés</div></div>
    <div class="stat"><div class="n"><%= total_tested %></div><div class="l">cases confirmées</div></div>
    <div class="stat"><div class="n"><%= total_pending %></div><div class="l">cases en attente</div></div>
    <div class="stat"><div class="n"><%= catalog_size %></div><div class="l">tuiles au catalogue</div></div>
  </div>

  <section>
    <h2>Carte du monde</h2>
    <p class="section-note">
